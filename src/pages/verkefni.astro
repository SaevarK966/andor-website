---
import RoutePreview from '../components/pages/RoutePreview.astro';
import { pageContent } from '../i18n/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const page = pageContent.is.projects;
---

<BaseLayout locale="is" route="projects" title={`${page.title} | AndOr`} description={page.meta} noindex>
  <RoutePreview locale="is" route="projects" />
</BaseLayout>
